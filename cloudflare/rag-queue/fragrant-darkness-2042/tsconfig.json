{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "es2022",
    "moduleResolution": "Bundler",

    "resolveJsonModule": true,

    "noEmit": true,
    "isolatedModules": true,

    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "worker-configuration.d.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "test"
  ]
}
